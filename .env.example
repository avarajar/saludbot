# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio (WhatsApp Business API)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+57XXXXXXXXXX

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key

# Google Calendar (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Cron Secret (for reminder endpoint auth)
CRON_SECRET=your-random-secret-here

# WhatsApp Content Templates (Twilio Content SIDs, formato HX...)
# Sin estos SIDs los mensajes salen como texto libre (solo sandbox / ventana 24h).
# Cuerpos sugeridos para registrar en Twilio (variables {{1}}=nombre, {{2}}=clinica, {{3}}=fecha, {{4}}=hora):
# reminder_48h: "Hola {{1}}, le recordamos su cita en {{2}} el {{3}} a las {{4}}. Responda 1 para confirmar o 2 para reagendar."
# reminder_24h: "Hola {{1}}, mañana tiene su cita en {{2}} a las {{4}}. ¿Nos confirma su asistencia? Responda 1 para confirmar."
# reminder_2h: "{{1}}, su cita en {{2}} es en 2 horas ({{4}}). ¡Lo/La esperamos!"
# post_visit: "Hola {{1}}, gracias por su visita a {{2}}. ¿Como le fue? Su opinion nos ayuda a mejorar."
# recall: "Hola {{1}}, en {{2}} le recordamos que ya es momento de su proximo {{3}}. Responda este mensaje y le agendamos con gusto."
TWILIO_TEMPLATE_REMINDER_48H=
TWILIO_TEMPLATE_REMINDER_24H=
TWILIO_TEMPLATE_REMINDER_2H=
TWILIO_TEMPLATE_POST_VISIT=
TWILIO_TEMPLATE_RECALL=
